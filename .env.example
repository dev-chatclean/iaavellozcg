# ===========================================================
#  IA Avelloz Campina — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env real.
#  Transporte pela plataforma ChatClean (Webhook + Push API).
# ===========================================================

# Chave da OpenAI (com crédito)
OPENAI_API_KEY=sk-...

# URL autenticada gerada em Configurações → API/Webhook → Adicionar (no painel ChatClean).
# O token JWT já vem embutido como ?token=... — não precisa de header.
CC_PUSH_URL=https://betaapi.chatclean.com.br/v1/api/external/UUID/?token=JWT

# WhatsApp interno da loja que recebe o resumo dos leads qualificados (opcional).
EQUIPE_NUMERO=5583999999999

# Segredo para proteger o webhook de entrada. Vazio = webhook ABERTO (qualquer
# um pode POSTar). ANTES DO GO-LIVE, defina um valor aleatório e configure a URL
# do webhook no painel ChatClean como https://.../webhook/<segredo>
# (o token também é aceito em ?token=<segredo> ou no header x-webhook-token).
WEBHOOK_SECRET=

# Rate-limit por número: máximo de mensagens por janela de tempo (anti-spam/loop
# e proteção de custo). 0 desativa. Padrão: 20 mensagens a cada 60s.
RATE_LIMIT_MSGS=20
RATE_LIMIT_JANELA_S=60

# Blindagem anti-loop (contra outras IAs/auto-respondedores): se o contato passar
# de LOOP_MAX_TURNOS mensagens em LOOP_JANELA_MIN minutos (ou repetir a mesma
# mensagem), a IA pausa as respostas. Padrão: 15 mensagens em 3 min.
LOOP_MAX_TURNOS=15
LOOP_JANELA_MIN=3

# Feriados extras/móveis (o expediente cai em plantão nesses dias). Lista por
# vírgula, "YYYY-MM-DD" (ano específico) ou "MM-DD" (recorrente). Os nacionais
# fixos já estão embutidos; adicione aqui Carnaval, Sexta-feira Santa, Corpus
# Christi (móveis) e feriados de Campina Grande-PB. Ex.: 2026-02-17,2026-04-03,06-24
FERIADOS=

# Números liberados na fase de teste (separados por vírgula).
# Vazio = responde a todos. Tolerante ao 9º dígito.
IA_ALLOWED_CONTACTS=5583999999999

# Persistência do estado das conversas (recomendado em produção).
# Sem REDIS_URL, o estado fica em memória e se perde no restart/redeploy.
REDIS_URL=
REDIS_PREFIX=avellozcg

# Porta do servidor
PORT=3000

# Chave para proteger os endpoints administrativos /leads e /diag (expõem dados
# de leads e config). SEM esta chave, os dois endpoints ficam BLOQUEADOS (503).
# Use em ?key=..., no header x-admin-key ou Authorization: Bearer.
ADMIN_KEY=

# Janela (ms) para agrupar mensagens rápidas do mesmo cliente antes de responder.
# 0 desativa o agrupamento. Padrão: 2000 (2s).
AGRUPAR_MENSAGENS_MS=2000

# A IA responde apenas em conversas individuais. Para permitir grupos, use false.
IGNORAR_GRUPOS=true

# A IA só responde tickets PENDENTES (na fila). Quando um humano aceita a conversa
# (ticket sai de "pending"), a IA para de responder. Para desativar, use false.
IA_SO_PENDENTES=true

# Reinicia o atendimento após N horas sem interação do cliente (padrão: 24)
RESET_INATIVIDADE_HORAS=24

# --- Transferência de departamento (fila do CRM) ---
# Ao qualificar o lead, a IA transfere o ticket para o departamento da loja que o
# CLIENTE escolheu, usando forceTicketToDepartment + queueId da Push API. Use false para
# voltar ao comportamento antigo (só nota interna, encaminhamento manual).
TRANSFERIR_DEPARTAMENTO=true
# A plataforma só reposiciona ticket FECHADO ou de primeiro contato. Se a
# transferência simples não mover o ticket de fila, ligue esta opção: o push
# fecha o ticket junto, que é o gatilho para ele reabrir já no departamento.
TRANSFERIR_FECHANDO=false
# IDs dos departamentos no painel (Configurações → Departamentos). Só preencha se
# forem diferentes dos padrões do data.js (Matriz 228, Malvinas 230, Monteiro 231).
DEPT_ID_MATRIZ=228
DEPT_ID_MALVINAS=230
DEPT_ID_MONTEIRO=231
# Departamentos SEM transferência automática. "Agente IA" é a porta de entrada:
# é onde o lead já está enquanto a IA atende, então quando a loja não é
# escolhida o ticket simplesmente permanece lá para a equipe direcionar.
# Preencha apenas se a operação tiver esses departamentos e quiser rotear neles.
DEPT_ID_AGENTE_IA=
# Pós-venda: sem ID aqui, o cliente atual é encaminhado para a unidade dele.
DEPT_ID_POSVENDA=

# --- Pipeline comercial / Oportunidades no CRM (opcional — DESLIGADO por padrão) ---
# Quando um lead é qualificado/transferido, a IA pode criar uma oportunidade no
# funil da loja. Reaproveita a base+token do CC_PUSH_URL (mesmo endpoint externo).
# Só liga quando PIPELINE_USER_ID e PIPELINE_RESPONSIBLE_ID estiverem preenchidos.
# Use PIPELINE_ENABLED=false para desligar mesmo com IDs setados.
PIPELINE_ENABLED=
# Etapa do funil (id) da Avelloz Campina — descubra no funil do CRM da loja.
PIPELINE_STEP_ID=
PIPELINE_STEP_NOME=LEAD QUALIFICADO
# userId que "cria" a oportunidade (obrigatório). Descubra em Configurações →
# Usuários (ou no ticket.userId quando o vendedor aceita uma conversa).
PIPELINE_USER_ID=
# userId do RESPONSÁVEL pela oportunidade (vendedor). Padrão = PIPELINE_USER_ID.
PIPELINE_RESPONSIBLE_ID=
# Nome fixo da oportunidade (o contato do lead já fica vinculado ao card).
PIPELINE_OPP_NOME=LEAD QUALIFICADO
# Valor padrão da oportunidade (aceita vírgula ou ponto). Padrão 1.
PIPELINE_VALOR=1

# --- Canal INSTAGRAM (API oficial da Meta — opcional, DESLIGADO por padrão) ---
# O ChatClean não tem conexão com o Instagram, então o Direct é falado direto
# com a Meta. As mensagens entram por /webhook/instagram e as respostas saem
# por graph.instagram.com. Todo o resto (qualificação, loja, departamento,
# resumo do lead) é o MESMO fluxo do WhatsApp.
#
# Sem IG_TOKEN o canal fica inativo e nada muda no comportamento atual.
#
# Token de acesso da conta profissional (longa duração, 60 dias — RENOVAR).
IG_TOKEN=
# String que VOCÊ inventa e repete no painel da Meta ao cadastrar o webhook.
# A Meta a devolve na verificação da URL; se não bater, o webhook não ativa.
IG_VERIFY_TOKEN=
# App Secret do app na Meta. Valida a assinatura (X-Hub-Signature-256) de cada
# webhook. VAZIO = validação PULADA e o endpoint fica aberto a quem souber a URL.
META_APP_SECRET=
# Versão da Graph API. Só mexa se a Meta descontinuar a atual.
IG_API_VERSION=v25.0
#
# ATENÇÃO: no Instagram o encaminhamento do lead qualificado acontece SOMENTE
# pelo EQUIPE_NUMERO (não existe ticket para transferir de fila). Sem ele, um
# lead qualificado no Direct não chega a ninguém.
